# Environment Configuration for FrontDoor Concierge
# Copy this file to .env and fill in your credentials

# ============================================================
# AWS Configuration (Required for Bedrock AI Analysis)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ============================================================
# Ring Configuration (Optional - falls back to simulator)
# Get your refresh token by running: npx -p ring-client-api ring-auth-cli
# ============================================================
RING_REFRESH_TOKEN=your_ring_refresh_token_here

# ============================================================
# Server Configuration
# ============================================================
PORT=3001
CLIENT_URL=http://localhost:5173

# ============================================================
# Demo Configuration
# ============================================================
AUTO_SIMULATE=true
SIMULATE_INTERVAL_MS=30000
